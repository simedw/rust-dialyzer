+#[cfg(test)]
+mod native_callback_tests {
+    use super::*;
+    use firefly_intern::Symbol;
+    use std::sync::Arc;
+
+    #[test]
+    fn native_optional_callbacks_decode_as_structural_attribute() {
+        let atom = |name: &str| etf::Term::Atom(etf::Atom::from(Symbol::intern(name)));
+        let function = etf::Term::Tuple(vec![atom("MACRO-optional"), etf::Term::Integer(2.into())].into());
+        let attr = etf::Term::Tuple(vec![atom("attribute"), etf::Term::Integer(3.into()), atom("optional_callbacks"), etf::Term::List(vec![function].into())].into());
+        let term = etf::Term::List(vec![attr].into());
+        let mut bytes = vec![];
+        term.encode(&mut bytes).unwrap();
+        let code = firefly_beam::AbstractCode::from_abstract_forms(&bytes).unwrap();
+        let abstr::Form::OptionalCallbacks(attr) = &code.forms[0] else {
+            panic!("optional_callbacks must not become a generic user attribute");
+        };
+        assert_eq!(attr.funs.len(), 1);
+        assert_eq!(attr.funs[0].name, Symbol::intern("MACRO-optional"));
+        assert_eq!(attr.funs[0].arity, 2);
+    }
+
+    #[test]
+    fn native_optional_callback_resolves_before_or_after_callback() {
+        for optional_first in [true, false] {
+            let codemap = Arc::new(CodeMap::new());
+            codemap.add(PathBuf::from("native-callback.erl"), "-module(test).\n".to_owned());
+            let emitter = Arc::new(CaptureEmitter::new());
+            let diagnostics = DiagnosticsHandler::new(DiagnosticsConfig::default(), codemap.clone(), emitter);
+            let loc = (1, 1).into();
+            let name = Symbol::intern("optional");
+            let callback = abstr::Form::Callback(abstr::CallbackAttr {
+                loc,
+                name: abstr::FunctionName::new(name, 0),
+                clauses: vec![abstr::Type::AnyFun(Box::new(abstr::AnyFunType::new(loc, None)))],
+            });
+            let optional = abstr::Form::OptionalCallbacks(abstr::OptionalCallbacksAttr::new(loc, vec![abstr::FunctionName::new(name, 0)]));
+            let mut forms = vec![
+                abstr::Form::File(abstr::FileAttr::new(loc, Symbol::intern("native-callback.erl"), 1)),
+                abstr::Form::Module(abstr::ModuleAttr::new(loc, Symbol::intern("test"))),
+            ];
+            if optional_first { forms.extend([optional, callback]); }
+            else { forms.extend([callback, optional]); }
+            let module = AbstractErlangToAst::new(&diagnostics, &codemap).run(abstr::Ast { forms }).unwrap();
+            assert!(module.callbacks[&FunctionName::new_local(name, 0)].optional);
+        }
+    }
