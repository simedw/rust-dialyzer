+        let mut generated = call;
+        generated.mark_compiler_generated();
+        let (result, _) = force_safe(&mut context, generated);
+        assert!(result.is_compiler_generated());
+        let (result, _) = force_safe(&mut context, IExpr::Call(ICall::new(SourceSpan::UNKNOWN, Symbol::intern("other"), Symbol::intern("get"), vec![])));
