+defmodule CompilerIdentity do
+  def implementation_inputs do
+    Enum.map([:erl_bif_types, :erl_types], fn module ->
+      module |> :code.which() |> List.to_string()
+    end)
+  end
+
+  def digest(request) do
+    native = Enum.map([:erl_bif_types, :erl_types, :dialyzer_typesig, :dialyzer_contracts,
+      :dialyzer_utils, :dialyzer_clean_core, :dialyzer_cplt], &:code.which/1)
+    identities = (request["implementation_files"] ++ Enum.map(native, &List.to_string/1))
+      |> Enum.map(&Path.expand/1) |> Enum.uniq() |> Enum.sort()
+    :crypto.hash(:sha256, :erlang.term_to_binary(Enum.map(identities, fn path ->
+      {path, :crypto.hash(:sha256, File.read!(path))}
+    end))) |> Base.encode16(case: :lower)
+  end
+
+end
