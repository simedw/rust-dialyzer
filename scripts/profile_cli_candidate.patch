+use std::time::Instant;
+pub struct Span {
+    name: String,
+    start: Instant,
+    enabled: bool,
+}
+impl Span {
+    pub fn new(name: impl Into<String>) -> Self {
+        Self {
+            name: name.into(),
+            start: Instant::now(),
+            enabled: std::env::var_os("RUST_DIALYZER_TRACE").is_some(),
+        }
+    }
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        if self.enabled {
+            eprintln!(
+                "PERF {} {:.6}",
+                self.name,
+                self.start.elapsed().as_secs_f64()
+            );
+        }
+    }
+}
